generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  socialId       String?  @unique
  name           String?
  
  password       String?
  provider       String   @default("email")
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  currentStreak  Int      @default(0)
  lastActiveDate DateTime? 
  
  onboardingData Json?
  goals          Goal[]
}

model Goal {
  id          String   @id @default(uuid())
  title       String
  status      String   @default("active")
  
  // Journey Fields
  type        String   @default("project") // 'project' or 'journey'
  targetDate  DateTime?
  startDate   DateTime @default(now())
  dailyMinutes Int     @default(45)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tasks       Task[]
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  duration    Int
  status      String   @default("queued")
  order       Int      @default(0)
  
  // Track which day this task belongs to
  dayNumber   Int      @default(1) 
  
  // NEW: Link fields
  linkUrl     String?
  linkLabel   String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
}