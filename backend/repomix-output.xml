    for (const prompt of starterPrompts) {
      // Avoid duplicates if some already exist
      const exists = await prisma.questionPrompt.findFirst({ where: { text: prompt.text } });
      if (!exists) {
        await prisma.questionPrompt.create({ data: prompt });
      }
    }
