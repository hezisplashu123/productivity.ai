{
  "expo": {
    "name": "ProdAI",
    "slug": "productivity-ai",
    "scheme": "hourback-ai",
    "version": "1.0.11",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mumix.productivityai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.204716304779-266i58dfvid6mg70reivvtdqqrpv2v9p"
            ]
          }
        ]
      },
      "entitlements": {}
    },
    "android": {
      "package": "com.mumix.productivityai"
    },
    "web": {
      "enabled": false
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9b268f70-3853-458e-9e63-5609a25ed759"
      }
    }
  }
}
