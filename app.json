{
  "expo": {
    "name": "HourBack AI",
    "slug": "productivity-ai",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E7"
    },
    "assetBundlePatterns": [
        "**/*"

    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mumix.productivityai",
      "entitlements": {
        "com.apple.developer.family-controls": true
      },
      "infoPlist": {
        "NSFamilyControlsUsageDescription": "We need access to screen time controls to help you block distractions during focus sessions.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8E7"
      },
      "package": "com.mumix.productivityai"
    },
    "scheme": "hourback-ai",
    "plugins": [
      "expo-router",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "9b268f70-3853-458e-9e63-5609a25ed759"
      }
    }
  }
}
