{
  "expo": {
    "name": "Realtalk",
    "slug": "productivity-ai",
    "scheme": [
      "realtalk",
      "exp+productivity-ai"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.realtalk.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.1063076160479-4kuapje5osfd4i2hegl3iji5nupq1j3g"
            ]
          }
        ]
      },
      "entitlements": {}
    },
    "android": {
      "package": "com.realtalk.app"
    },
    "web": {
      "enabled": false
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "9b268f70-3853-458e-9e63-5609a25ed759"
      }
    }
  }
}
