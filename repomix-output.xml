              disabled={!selectedRating}
              activeOpacity={0.8}
            >
              <Text style={[styles.submitButtonText, { color: colors.background }]}>Continue</Text>
            </TouchableOpacity>
          </View>
        </Animated.View>
      </View>
    </Modal>
  );
};

