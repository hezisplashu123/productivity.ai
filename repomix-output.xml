              {task.completed ? (
                <CheckCircle2 size={24} color={colors.primary} fill={colors.primary} />
              ) : (
                <Circle size={24} color={colors.border} strokeWidth={2} />
              )}
            </View>
          </View>
        </View>
      </TouchableOpacity>
    </View>
  );
};

