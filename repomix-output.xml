    shadowRadius: 8,
    elevation: 8,
    justifyContent: 'center',
    alignItems: 'center',
  },
  innerDot: {
    width: 6,
    height: 6,
    borderRadius: 3,
    backgroundColor: '#FFFFFF',
  },
  redLine: {
    flex: 1,
    height: 2,
    backgroundColor: colors.error,
    marginLeft: 6,
